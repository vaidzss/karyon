# Karyon Defense Mesh Configuration
PORT=8000
HOST=127.0.0.1
ENABLE_SQLITE_LLM_CACHE=true
SCHEMA_ROTATION_INTERVAL_SEC=60

# Baseten Inference API (Primary Model: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Local Ollama Fallback (if cloud API key unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
